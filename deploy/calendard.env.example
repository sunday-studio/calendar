# Copy to deploy/calendard.env (git-ignored) and fill in. Secrets are NOT set here: they are files in deploy/secrets/.

# Your tailnet name, as shown in the Tailscale admin console. Must match the redirect URI registered with Google:
#   https://calendar.<tailnet>.ts.net/auth/google/callback
CALENDAR_PUBLIC_URL=https://calendar.example-tailnet.ts.net

# Nightly encrypted backup (03:00 local by default), newest N kept. Backups are readable only with the master key.
CALENDAR_BACKUP_KEEP=14
CALENDAR_BACKUP_HOUR=3

# Sync cadence: while the app is connected / otherwise
CALENDAR_SYNC_FAST=60s
CALENDAR_SYNC_SLOW=5m

# Push notifications (leave empty to disable). Also uncomment the apns_key secret and CALENDAR_APNS_KEY_FILE in compose.yaml.
CALENDAR_APNS_KEY_ID=
CALENDAR_APNS_TEAM_ID=
CALENDAR_APNS_TOPIC=dev.casprine.calendar

# alfather (M8). Off unless the URL is set. See docs/alfather.md.
# CALENDAR_ALFATHER_URL=http://alfather.lan:8080/mcp
# CALENDAR_ALFATHER_PARSE_TOOL=parse_event
# CALENDAR_ALFATHER_TOKEN=
# Set to 1 to stop serving the hub's own MCP endpoint (POST /mcp)
# CALENDAR_MCP_DISABLE=0

# Abuse limits (defaults shown): POST /mcp calls per token per minute and body size; invalid-token attempts per client per window
# CALENDAR_MCP_RATE=120
# CALENDAR_MCP_MAX_BODY=262144
# CALENDAR_AUTH_FAIL_LIMIT=20
# CALENDAR_AUTH_FAIL_WINDOW=1m
