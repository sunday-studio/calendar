# Copy to deploy/calendard.env (git-ignored, chmod 600) and fill in.
# With compose.host-tailscale.yaml / compose.yaml the master key and the Google client are FILES in deploy/secrets/.
# With compose.image.yaml (published image, docs/ops/compose-example.md) they are VALUES set below.

# --- Secrets as values (compose.image.yaml). Leave commented when you use the secret files. -------------------
# 32 random bytes, base64 or hex:  head -c32 /dev/urandom | base64      Back it up OUTSIDE the server: backups are unreadable without it.
# CALENDAR_MASTER_KEY=
# The OAuth client from Google Cloud (type iOS or Web). CALENDAR_PUBLIC_URL below must be https for Google.
# CALENDAR_GOOGLE_CLIENT_ID=
# CALENDAR_GOOGLE_CLIENT_SECRET=

# Your tailnet name, as shown in the Tailscale admin console. Must match the redirect URI registered with Google:
#   https://calendar.<tailnet>.ts.net/auth/google/callback
CALENDAR_PUBLIC_URL=https://calendar.example-tailnet.ts.net

# ICS subscription feeds: poll cadence, and whether a feed may live on a private address (default off)
# CALENDAR_ICS_POLL=15m
# CALENDAR_ICS_ALLOW_PRIVATE=0

# Nightly encrypted backup (03:00 local by default), newest N kept. Backups are readable only with the master key.
# The folder itself (CALENDAR_BACKUP_DIR) is set by the compose file. CALENDAR_BACKUP_PLAIN=1 turns encryption off.
CALENDAR_BACKUP_KEEP=14
CALENDAR_BACKUP_HOUR=3

# Sync cadence: while the app is connected / otherwise
CALENDAR_SYNC_FAST=60s
CALENDAR_SYNC_SLOW=5m

# Push notifications (leave empty to disable). With the secret-file composes use CALENDAR_APNS_KEY_FILE instead of the value.
# The .p8 can come as a file (CALENDAR_APNS_KEY_FILE) or as a value; for a value on one line use:  base64 -i AuthKey_XXXX.p8 | tr -d '\n'
CALENDAR_APNS_KEY=
CALENDAR_APNS_KEY_ID=
CALENDAR_APNS_TEAM_ID=
CALENDAR_APNS_TOPIC=com.yourname.calendar

# alfather (M8). Off unless the URL is set. See docs/engineering/alfather.md.
# CALENDAR_ALFATHER_URL=http://alfather.lan:8080/mcp
# CALENDAR_ALFATHER_PARSE_TOOL=parse_event
# CALENDAR_ALFATHER_TOKEN=
# Set to 1 to stop serving the hub's own MCP endpoint (POST /mcp)
# CALENDAR_MCP_DISABLE=0

# Abuse limits (defaults shown): POST /mcp calls per token per minute and body size; invalid-token attempts per client per window
# CALENDAR_MCP_RATE=120
# CALENDAR_MCP_MAX_BODY=262144
# CALENDAR_AUTH_FAIL_LIMIT=20
# CALENDAR_AUTH_FAIL_WINDOW=1m

# ---------------------------------------------------------------------------------------------------------
# Observability (OpenTelemetry). OFF unless an OTLP endpoint is set; with nothing below set the hub behaves
# exactly as before (no exporters, no network). Standard OTEL_* variables only. Details: docs/engineering/observability.md
# Minimal: uncomment the endpoint (and headers if your backend wants a key), restart, run `calendard doctor`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# CALENDAR_OTEL_TOKEN=                             # shortcut: just the token; sent as "Authorization: Bearer <token>" (an Authorization entry in the headers wins)
# OTEL_SERVICE_NAME=calendard
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=   # per-signal override of the endpoint (also _METRICS_ and _LOGS_); full URL including /v1/traces
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf        # or grpc
# OTEL_TRACES_SAMPLER=parentbased_always_on        # or parentbased_traceidratio with OTEL_TRACES_SAMPLER_ARG=0.25
# OTEL_METRIC_EXPORT_INTERVAL=60000                # ms
# Log level: CALENDAR_LOG_LEVEL=debug|info|warn|error|off (a minimum; default info; stdout and OTLP) or a list such as info,error (exactly those levels). CALENDAR_OTEL_LOG_LEVEL overrides the OTLP side only.
# One signal off: OTEL_TRACES_EXPORTER=none | OTEL_METRICS_EXPORTER=none | OTEL_LOGS_EXPORTER=none. Everything off: OTEL_SDK_DISABLED=true
#
# Examples (header values are secrets: keep this file chmod 600; a space inside a header value is written %20):
#  Local collector / SigNoz self-hosted (collector on the Docker host, hub in a container; OrbStack/Docker Desktop name):
#    OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
#  Grafana Cloud (stack > Connections > OpenTelemetry; user = instance id, password = a token with the MetricsPublisher role):
#    OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
#    OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instanceID:token>      # %20 syntax per the OTel spec; check Grafana's snippet
#  Honeycomb (EU: https://api.eu1.honeycomb.io):
#    OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
#    OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<ingest key>
#  SigNoz Cloud (UNVERIFIED syntax; copy the exact values from SigNoz > Settings > Ingestion):
#    OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
#    OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<key>
#    OTEL_EXPORTER_OTLP_PROTOCOL=grpc
